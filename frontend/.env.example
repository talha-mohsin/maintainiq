# ============================================================
# MaintainIQ Frontend — Environment Variables
# Copy this file to .env and fill in your actual values.
# Only VITE_-prefixed vars are exposed to client-side code.
# ============================================================

# Backend API base URL. Leave unset for a same-origin unified deploy
# (falls back to relative "/api"). Set explicitly for split-domain
# deploys (e.g. S3/CloudFront frontend + EC2 backend).
VITE_API_URL=https://api.yourdomain.com/api
